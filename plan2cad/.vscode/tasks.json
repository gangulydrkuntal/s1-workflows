{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "plan2cad: doctor (check environment)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "plan2cad", "doctor"],
      "problemMatcher": []
    },
    {
      "label": "plan2cad: validate all configs",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "plan2cad", "validate", "configs"],
      "problemMatcher": []
    },
    {
      "label": "plan2cad: run all drawings",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "plan2cad", "run", "configs", "--out", "output"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "plan2cad: run current config file",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "plan2cad", "run", "${file}", "--out", "output"],
      "problemMatcher": []
    },
    {
      "label": "plan2cad: run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
